# Copia este archivo como .env y ajusta lo que quieras activar.

# auto: usa Ollama si esta encendido; si no, Gemini si hay API key.
# ollama: fuerza modelo local.
# gemini: fuerza Gemini.
# bigpickle: usa Big Pickle (OpenCode Zen), el modelo por defecto.
BOLT_MODEL_PROVIDER=bigpickle

# Clave de Big Pickle (OpenCode) — obtenla en https://opencode.ai/auth
OPENCODE_API_KEY=

# Base URL del proveedor Big Pickle.
# BOLT_BIGPICKLE_BASE_URL=https://opencode.ai/zen/v1

# Modelo local servido por Ollama.
BOLT_LOCAL_MODEL=llama3.1
BOLT_OLLAMA_BASE_URL=http://localhost:11434

# Gemini opcional. No dejes claves dentro del codigo.
GEMINI_API_KEY=
BOLT_GEMINI_MODEL=gemini-2.5-flash

BOLT_MAX_AGENT_STEPS=6

# Guardias anti-bucle del agente.
BOLT_DUPLICATE_WINDOW=4
BOLT_MAX_REPEAT_TOOL=3
BOLT_MAX_TOOLS_PER_TURN=6

# Log de traza en MEMORY/v12/logs/
BOLT_TRACE_ENABLED=true
BOLT_LOG_RETENTION_DAYS=7
